dist/
build/

# Web (Node/Vite)
node_modules/
*.tsbuildinfo

# Data & models — never commit videos or weights
# `data/*` and not `data/`: git cannot re-include a file whose parent directory
# is excluded, so with `data/` the exceptions below silently did nothing.
data/*
# ...except our own hand-made labels: 2,377 hits typed one by one. They are the
# scarcest asset in the project (they cannot be regenerated) and weigh 400 KB.
!data/labels/
data/labels/*
!data/labels/types/
# Hand-marked courts: 6 clicks each, verified to a few cm.
!data/datasets/
data/datasets/*
!data/datasets/courts/
*.pt
*.onnx
runs/

# Experiment tracking
mlruns/
mlartifacts/
mlruns.db
*.mlflow.db

# Outputs
output/
*.mp4
*.avi
*.mov

# IDE / OS
.vscode/
.idea/
.DS_Store
# Points exported for the web viewer (scripts/export_points.py): 1080p videos,
# regenerable from the raw rallies, far too heavy for git.
packages/web/public/points/

# Local assistant configuration: kept on this machine, not part of the project
CLAUDE.md
.claude/
